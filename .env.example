PORT=8787
LOCD_LOG_LEVEL=info

# Strict deployment safety gate. Keep false for local/dev; true requires auth, rate limiting, durable telemetry and durable policy state.
LOCD_PRODUCTION_STRICT=false

# When set, all /v1 endpoints require Bearer or X-LOCD-API-Key authentication.
LOCD_API_KEY=

# Tenant bound to the legacy admin key when no scoped JSON keys are configured.
LOCD_LEGACY_TENANT_ID=default

# Optional JSON file for persistent target registry state.
LOCD_TARGETS_FILE=

# Maximum JSON request body size in bytes.
LOCD_MAX_BODY_BYTES=1000000

# Optional requests per minute limit for /v1 endpoints. 0 disables the limiter.
LOCD_RATE_LIMIT_RPM=0

# Failed authentication attempts per minute per client when API auth is enabled.
LOCD_AUTH_FAILURE_RPM=30

# Set true only when the deployment proxy is trusted and supplies X-Forwarded-For.
LOCD_TRUST_PROXY=false

# Optional JSON file for bounded decision telemetry persistence.
LOCD_TELEMETRY_FILE=

# Optional JSON file defining server-side provider adapters. Secrets are referenced by env name.
LOCD_PROVIDERS_FILE=

# Optional JSON file for tenant-scoped versioned policy control-plane state.
LOCD_POLICIES_FILE=

# Optional provider secret referenced by an Anthropic entry in LOCD_PROVIDERS_FILE.
ANTHROPIC_API_KEY=

# Optional scheduled provider probing interval in milliseconds. 0 disables automatic probing.
LOCD_PROBE_INTERVAL_MS=0

# Maximum provider probes that can run concurrently.
LOCD_PROBE_MAX_CONCURRENT=4

# Explicit opt-in for live execution through POST /v1/execute.
LOCD_EXECUTION_ENABLED=false

# Optional JSON array for scoped API keys. Store only environment variable names here.
# Example: [{"id":"reader","secretEnv":"LOCD_READER_KEY","scopes":["read"]}]
LOCD_API_KEYS_JSON=

# Optional scoped credential secret referenced by LOCD_API_KEYS_JSON.
LOCD_READER_KEY=

# Opt-in telemetry calibration. Uses completed decision outcomes to adjust estimates.
LOCD_CALIBRATION_ENABLED=false

# Optional SQLite state database for durable telemetry and shared coordination.
# Intended for a single host or shared filesystem deployment.
LOCD_STATE_DB_FILE=

# Optional network coordination service for multi-host rate limiting/idempotency.
# LOCD_STATE_DB_FILE takes precedence when both are set.
LOCD_COORDINATION_URL=
LOCD_COORDINATION_API_KEY=

# Optional network State Service for shared telemetry + coordination across API instances.
# This also enables shared tenant-scoped policy state; local LOCD_POLICIES_FILE is then ignored.
# Takes precedence over LOCD_COORDINATION_URL when present (unless SQLite is enabled).
LOCD_STATE_SERVICE_URL=
# Required by the State Service itself; the service fails closed when this is unset.
LOCD_STATE_SERVICE_API_KEY=

# Lock duration for in-progress idempotency claims.
LOCD_IDEMPOTENCY_LOCK_TTL_MS=30000

# HTTP resource guards. These prevent slow/incomplete requests and recycle idle connections.
LOCD_REQUEST_TIMEOUT_MS=30000
LOCD_HEADERS_TIMEOUT_MS=10000
LOCD_KEEP_ALIVE_TIMEOUT_MS=5000
LOCD_MAX_REQUESTS_PER_SOCKET=0

# Graceful shutdown grace period before active HTTP connections are force-closed.
LOCD_SHUTDOWN_TIMEOUT_MS=10000

# Internal State Service HTTP resource guards.
LOCD_STATE_SERVICE_REQUEST_TIMEOUT_MS=30000
LOCD_STATE_SERVICE_HEADERS_TIMEOUT_MS=10000
LOCD_STATE_SERVICE_KEEP_ALIVE_TIMEOUT_MS=5000
LOCD_STATE_SERVICE_MAX_REQUESTS_PER_SOCKET=0

# Maximum time for API requests to the internal HTTP State Service.
LOCD_STATE_CLIENT_TIMEOUT_MS=5000
