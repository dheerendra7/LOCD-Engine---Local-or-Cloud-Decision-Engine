{
  "name": "locd-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Vendor-neutral local/private/cloud/hybrid workload placement decision engine.",
  "type": "module",
  "scripts": {
    "start": "node apps/api/src/server.js",
    "dev": "node --watch apps/api/src/server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "node scripts/lint.mjs",
    "start:state": "node apps/state-service/src/server.js",
    "dev:state": "node --watch apps/state-service/src/server.js",
    "state:backup": "node packages/cli/bin/locd.mjs backup"
  },
  "engines": {
    "node": ">=22.16.0 <25.0.0"
  },
  "license": "MIT",
  "packageManager": "npm@11"
}
